OPENAI_API_KEY=

# Firebase (buyer + merchant auth / Firestore — public web config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Settlement chains: USDC x402 on Arbitrum, Base and HyperEVM (docs/chains.md)
#   Arbitrum Sepolia eip155:421614 (default) · Arbitrum One eip155:42161
#   Base Sepolia     eip155:84532            · Base         eip155:8453
#   HyperEVM Testnet eip155:998              · HyperEVM     eip155:999
# Token, RPC, explorer and EIP-712 domain are derived from the network.
# CHAIN_NETWORK is the primary chain. Labels work too: base-sepolia, hyperevm-testnet.
CHAIN_NETWORK=eip155:421614
# Extra chains offered in the same 402 (comma-separated). The buyer pays on one.
# SETTLE_NETWORKS=base-sepolia,hyperevm-testnet
# Chain the buyer agent prefers. Unset: first accepted chain where it holds enough.
# BUYER_NETWORK=base-sepolia
# RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# RPC for a non-primary chain: RPC_URL_<chainId>
# RPC_URL_84532=https://sepolia.base.org
# RPC_URL_998=https://rpc.hyperliquid-testnet.xyz/evm
# EVM 0x… address that receives USDC (merchant payTo)
MERCHANT_ADDRESS=
# Buyer private key for server-side x402 signing (never commit real keys)
BUYER_PRIVATE_KEY=
# Relayer that submits the settlement tx. Needs gas on every enabled chain:
# ETH on Arbitrum and Base, HYPE on HyperEVM. Falls back to BUYER_PRIVATE_KEY.
# FACILITATOR_PRIVATE_KEY=
# Overrides (normally leave unset):
# TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
# EXPLORER_BASE=https://sepolia.arbiscan.io
# Public origin for links to this site's own explorer (HyperEVM Testnet has no
# public one). Defaults to Vercel's production domain.
# SITE_URL=https://crypto-worlds-fair.vercel.app

# Gas top-up (/buyer/gas): bridges ETH from the parent chain to Arbitrum with
# @arbitrum/sdk. Parent is Ethereum Sepolia for Arbitrum Sepolia, Ethereum for
# Arbitrum One. Defaults to a public RPC; set your own for reliability.
# PARENT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# PARENT_EXPLORER_BASE=https://sepolia.etherscan.io
# Per-deposit cap (defaults: 0.05 testnet, 0.005 mainnet)
# BRIDGE_MAX_DEPOSIT_ETH=0.05

# Liquidity routes use Uniswap V3 on Arbitrum One (no API key). Uniswap has no
# USDC liquidity on Arbitrum Sepolia, so on testnet the UI shows a live Arbitrum
# One quote (quote only, never executed). 0 disables.
# DEX_MAINNET_PREVIEW=1

# BorneoCheckout contract (contracts/), one per chain: CHECKOUT_ADDRESS_<chainId>.
# When set, x402 on that chain pays the contract with an order-bound
# ReceiveWithAuthorization; it splits merchant / treasury fee on-chain and credits
# XPoints. Leave a chain out to pay merchants directly there.
# (Un-suffixed CHECKOUT_ADDRESS still works for the primary chain.)
CHECKOUT_ADDRESS_421614=0xf8188490C10d0248DBB27bD1A07F8a7b4f0e9fc4
# CHECKOUT_ADDRESS_84532=
# CHECKOUT_ADDRESS_998=

# Second EIP-3009 settle asset for multi-asset SKUs. Defaults to Paxos USDG
# (Arbitrum Sepolia 0xFFC9…1892, Arbitrum One 0x004B…9bbC).
# ALT_SETTLE_TOKEN=0x…
# ALT_SETTLE_SYMBOL=USDG

# Protocol fee in bps. Must match BorneoCheckout.feeBps on every chain with a checkout.
PROTOCOL_FEE_BPS=50
# Fee recipient used when deploying BorneoCheckout (defaults to the deployer).
TREASURY_ADDRESS=

# Optional: DynamoDB catalog instead of Firestore (Lambda / AWS)
# AISLE_TABLE=

# Setup: docs/chains.md (all chains) · scripts/setup-arbitrum-usdc.md (Arbitrum)
# Preflight before settling: npm run chains:check
